{{- /*
counterfeiter template for mockery (https://vektra.github.io/mockery/)

Generates fakes with the same API as counterfeiter: <Method>Stub,
<Method>CallCount, <Method>Calls, <Method>ArgsForCall, <Method>Args,
<Method>Returns, <Method>ReturnsOnCall, Invocations and CallOrder.
See mockery/README.md for the recommended .mockery.yml.
*/ -}}

{{- /* The returns struct is written four times per method. Its fields are
unexported, so they keep counterfeiter's resultN names. */}}
{{- define "returnsStruct" }}struct {
		{{- range $i, $r := .Returns }}
		result{{ incr $i }} {{ $r.TypeString }}
		{{- end }}
	}{{ end }}

{{- /* An interface's own template-data wins over the file's. */}}
{{- $boilerplate := index .TemplateData "boilerplate-file" }}
{{- range .Interfaces }}{{ with index .TemplateData "boilerplate-file" }}{{ $boilerplate = . }}{{ end }}{{ end }}
{{- with $boilerplate }}{{ readFile . }}{{ end -}}
// Code generated by counterfeiter. DO NOT EDIT.
package {{ .PkgName }}

{{- /* Another package named sync may already be imported, so use whatever
qualifier mockery gives the standard library's. */}}
{{- $sync := (.Registry.AddImport "sync" "sync").Qualifier }}
{{- /*
mockery leaves SrcPkgQualifier empty when the fakes live in the source
package. Otherwise the source package is imported only for the compile-time
assertions of exported interfaces (an unexported one cannot be named from
outside its package), and its qualifier is taken from the import in case
mockery had to alias it.
*/}}
{{- $inPackage := not .SrcPkgQualifier }}
{{- $srcQualifier := .SrcPkgQualifier }}
{{- if not $inPackage }}
	{{- range .Interfaces }}
		{{- if not (firstIsLower .Name) }}
			{{- $srcQualifier = printf "%s." ($.Registry.AddImport $.Registry.SrcPkgName $.Registry.SrcPkg.PkgPath).Qualifier }}
		{{- end }}
	{{- end }}
{{- end }}

import (
	{{- range .Imports }}
	{{ .ImportStatement }}
	{{- end }}
)

{{ range $mock := .Interfaces -}}
type {{ $mock.StructName }}{{ $mock.TypeConstraint }} struct {
	{{- range $method := $mock.Methods }}
	{{- $args := "struct{}" }}
	{{- if $method.Params }}{{ $args = printf "%s%sArgs%s" $mock.StructName ($method.Name | firstUpper) $mock.TypeInstantiation }}{{ end }}
	{{ $method.Name }}Stub func({{ $method.ArgTypeListEllipsis }}) {{ $method.ReturnArgTypeList }}
	{{ $method.Name | firstLower }}Mutex {{ $sync }}.RWMutex
	{{ $method.Name | firstLower }}ArgsForCall []{{ $args }}
	{{- if $method.Returns }}
	{{ $method.Name | firstLower }}Returns {{ template "returnsStruct" $method }}
	{{ $method.Name | firstLower }}ReturnsOnCall map[int]{{ template "returnsStruct" $method }}
	{{- end }}
	{{- end }}
	invocations      map[string][][]interface{}
	callOrder        []string
	invocationsMutex {{ $sync }}.RWMutex
}

{{ range $method := $mock.Methods -}}
{{ if $method.Params -}}
// {{ $mock.StructName }}{{ $method.Name | firstUpper }}Args holds the arguments of one call to {{ $method.Name }}.
type {{ $mock.StructName }}{{ $method.Name | firstUpper }}Args{{ $mock.TypeConstraint }} struct {
	{{- range $i, $p := $method.Params }}
	Arg{{ incr $i }} {{ $p.TypeString }}
	{{- end }}
}

{{ end -}}
{{ end -}}

{{ range $method := $mock.Methods -}}
{{- $lower := $method.Name | firstLower -}}
{{- $upper := $method.Name | firstUpper -}}
{{- $receiver := printf "%s%s" $mock.StructName $mock.TypeInstantiation -}}
{{- $args := "struct{}" -}}
{{- if $method.Params }}{{ $args = printf "%s%sArgs%s" $mock.StructName $upper $mock.TypeInstantiation }}{{ end -}}
{{- /* Locals must not shadow the parameters or a package the method's types
refer to; the method's scope already holds both. */ -}}
{{- $scope := $method.Scope -}}
{{- $fake := $scope.AllocateName "fake" -}}
{{- $stub := $scope.AllocateName "stub" -}}
{{- $ret := $scope.AllocateName "ret" -}}
{{- $specificReturn := $scope.AllocateName "specificReturn" -}}
{{- $fakeReturns := $scope.AllocateName "fakeReturns" -}}
{{- $argsForCall := $scope.AllocateName "argsForCall" -}}
{{- $argsCopy := $scope.AllocateName "args" -}}
{{- $index := $scope.AllocateName "i" -}}
func ({{ $fake }} *{{ $receiver }}) {{ $method.Name }}({{ $method.ArgList }}) {{ $method.ReturnArgTypeList }} {
	{{- /* Slice arguments are recorded as copies, so later changes by the
	caller do not show up in ArgsForCall. */}}
	{{- $recorded := "" }}
	{{- range $i, $p := $method.Params }}
	{{- $name := $p.Name }}
	{{- if $p.Var.IsSlice }}
	{{- $name = $scope.AllocateName (printf "%sCopy" $p.Name) }}
	var {{ $name }} {{ $p.TypeString }}
	if {{ $p.Name }} != nil {
		{{ $name }} = make({{ $p.TypeString }}, len({{ $p.Name }}))
		copy({{ $name }}, {{ $p.Name }})
	}
	{{- end }}
	{{- if $i }}{{ $recorded = printf "%s, " $recorded }}{{ end }}
	{{- $recorded = printf "%s%s" $recorded $name }}
	{{- end }}
	{{ $fake }}.{{ $lower }}Mutex.Lock()
	{{- if $method.Returns }}
	{{ $ret }}, {{ $specificReturn }} := {{ $fake }}.{{ $lower }}ReturnsOnCall[len({{ $fake }}.{{ $lower }}ArgsForCall)]
	{{- end }}
	{{ $fake }}.{{ $lower }}ArgsForCall = append({{ $fake }}.{{ $lower }}ArgsForCall, {{ $args }}{ {{- $recorded -}} })
	{{ $stub }} := {{ $fake }}.{{ $method.Name }}Stub
	{{- if $method.Returns }}
	{{ $fakeReturns }} := {{ $fake }}.{{ $lower }}Returns
	{{- end }}
	{{ $fake }}.recordInvocation("{{ $method.Name }}", []interface{}{ {{- $recorded -}} })
	{{ $fake }}.{{ $lower }}Mutex.Unlock()
	if {{ $stub }} != nil {
		{{ if $method.Returns }}return {{ end }}{{ $stub }}({{ $method.ArgCallList }})
	}
	{{- if $method.Returns }}
	if {{ $specificReturn }} {
		return {{ range $i, $r := $method.Returns }}{{ if $i }}, {{ end }}{{ $ret }}.result{{ incr $i }}{{ end }}
	}
	return {{ range $i, $r := $method.Returns }}{{ if $i }}, {{ end }}{{ $fakeReturns }}.result{{ incr $i }}{{ end }}
	{{- end }}
}

func ({{ $fake }} *{{ $receiver }}) {{ $upper }}CallCount() int {
	{{ $fake }}.{{ $lower }}Mutex.RLock()
	defer {{ $fake }}.{{ $lower }}Mutex.RUnlock()
	return len({{ $fake }}.{{ $lower }}ArgsForCall)
}

func ({{ $fake }} *{{ $receiver }}) {{ $upper }}Calls({{ $stub }} func({{ $method.ArgTypeListEllipsis }}) {{ $method.ReturnArgTypeList }}) {
	{{ $fake }}.{{ $lower }}Mutex.Lock()
	defer {{ $fake }}.{{ $lower }}Mutex.Unlock()
	{{ $fake }}.{{ $method.Name }}Stub = {{ $stub }}
}

{{ if $method.Params -}}
func ({{ $fake }} *{{ $receiver }}) {{ $upper }}ArgsForCall({{ $index }} int) {{ if gt (len $method.Params) 1 }}({{ $method.ArgTypeList }}){{ else }}{{ $method.ArgTypeList }}{{ end }} {
	{{ $fake }}.{{ $lower }}Mutex.RLock()
	defer {{ $fake }}.{{ $lower }}Mutex.RUnlock()
	{{ $argsForCall }} := {{ $fake }}.{{ $lower }}ArgsForCall[{{ $index }}]
	return {{ range $i, $p := $method.Params }}{{ if $i }}, {{ end }}{{ $argsForCall }}.Arg{{ incr $i }}{{ end }}
}

func ({{ $fake }} *{{ $receiver }}) {{ $upper }}Args() []{{ $args }} {
	{{ $fake }}.{{ $lower }}Mutex.RLock()
	defer {{ $fake }}.{{ $lower }}Mutex.RUnlock()
	{{ $argsCopy }} := make([]{{ $args }}, len({{ $fake }}.{{ $lower }}ArgsForCall))
	copy({{ $argsCopy }}, {{ $fake }}.{{ $lower }}ArgsForCall)
	return {{ $argsCopy }}
}
{{- end }}

{{ if $method.Returns -}}
func ({{ $fake }} *{{ $receiver }}) {{ $upper }}Returns({{ $method.ReturnArgList }}) {
	{{ $fake }}.{{ $lower }}Mutex.Lock()
	defer {{ $fake }}.{{ $lower }}Mutex.Unlock()
	{{ $fake }}.{{ $method.Name }}Stub = nil
	{{ $fake }}.{{ $lower }}Returns = {{ template "returnsStruct" $method }}{ {{- $method.ReturnArgNameList -}} }
}

func ({{ $fake }} *{{ $receiver }}) {{ $upper }}ReturnsOnCall({{ $index }} int, {{ $method.ReturnArgList }}) {
	{{ $fake }}.{{ $lower }}Mutex.Lock()
	defer {{ $fake }}.{{ $lower }}Mutex.Unlock()
	{{ $fake }}.{{ $method.Name }}Stub = nil
	if {{ $fake }}.{{ $lower }}ReturnsOnCall == nil {
		{{ $fake }}.{{ $lower }}ReturnsOnCall = make(map[int]{{ template "returnsStruct" $method }})
	}
	{{ $fake }}.{{ $lower }}ReturnsOnCall[{{ $index }}] = {{ template "returnsStruct" $method }}{ {{- $method.ReturnArgNameList -}} }
}

{{ end -}}
{{ end }}

func (fake *{{ $mock.StructName }}{{ $mock.TypeInstantiation }}) Invocations() map[string][][]interface{} {
	fake.invocationsMutex.RLock()
	defer fake.invocationsMutex.RUnlock()
	copiedInvocations := map[string][][]interface{}{}
	for key, value := range fake.invocations {
		copiedInvocations[key] = value
	}
	return copiedInvocations
}

func (fake *{{ $mock.StructName }}{{ $mock.TypeInstantiation }}) CallOrder() []string {
	fake.invocationsMutex.RLock()
	defer fake.invocationsMutex.RUnlock()
	order := make([]string, len(fake.callOrder))
	copy(order, fake.callOrder)
	return order
}

func (fake *{{ $mock.StructName }}{{ $mock.TypeInstantiation }}) recordInvocation(key string, args []interface{}) {
	fake.invocationsMutex.Lock()
	defer fake.invocationsMutex.Unlock()
	fake.callOrder = append(fake.callOrder, key)
	if fake.invocations == nil {
		fake.invocations = map[string][][]interface{}{}
	}
	if fake.invocations[key] == nil {
		fake.invocations[key] = [][]interface{}{}
	}
	fake.invocations[key] = append(fake.invocations[key], args)
}

{{ if or (not (firstIsLower $mock.Name)) $inPackage -}}
{{ if $mock.TypeParams -}}
func _{{ $mock.TypeConstraint }}() {
	var _ {{ $srcQualifier }}{{ $mock.Name }}{{ $mock.TypeInstantiation }} = new({{ $mock.StructName }}{{ $mock.TypeInstantiation }})
}
{{- else -}}
var _ {{ $srcQualifier }}{{ $mock.Name }} = new({{ $mock.StructName }})
{{- end }}
{{- end }}

{{ end -}}
